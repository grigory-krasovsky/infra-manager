# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# ---- database (used by docker-compose for both services) -------------------
POSTGRES_DB=inframanager
POSTGRES_USER=inframanager
POSTGRES_PASSWORD=

# Host-side port mappings. Change if something already listens there.
DB_HOST_PORT=5433
APP_HOST_PORT=8080

# ---- app -------------------------------------------------------------------
LOG_LEVEL=INFO

# ---- Telegram --------------------------------------------------------------
# While disabled, notifications are still queued and marked SKIPPED, so nothing
# is lost silently. Chat ids live in the app config, not here.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Only if api.telegram.org is unreachable directly. Applies to Telegram alone --
# Bitbucket and Bamboo are on the internal network and must not be proxied.
# HTTP proxy only: the JDK http client cannot do SOCKS. A proxy running on the
# Docker host is host.docker.internal:<port> from inside the container.
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

# ---- Bamboo ----------------------------------------------------------------
# none | webhook | poll. Start at none; switch to webhook once the template in
# docs/bamboo-webhook-template.json is installed, or to poll if this Bamboo has
# no Communication -> Webhook templates section.
BAMBOO_SOURCE=none
# The shared secret the webhook template sends back to us. Required for webhook.
BAMBOO_WEBHOOK_SECRET=
# Required for poll only.
BAMBOO_BASE_URL=http://host.docker.internal:8085
BAMBOO_TOKEN=

# ---- Bitbucket -------------------------------------------------------------
# Exposes /webhooks/bitbucket when enabled. The secret must match the one set on
# the webhook in Bitbucket; it is what the X-Hub-Signature HMAC is computed with.
BITBUCKET_ENABLED=false
# Reconstructs pull request events by polling. Use this when Bitbucket cannot
# open a connection to the service -- the normal case outside the corp network.
BITBUCKET_POLL_ENABLED=false
BITBUCKET_WEBHOOK_SECRET=
BITBUCKET_BASE_URL=http://host.docker.internal:7990
# Only if a human clicking a card link needs a different address than the one the
# container dials. Defaults to BITBUCKET_BASE_URL.
BITBUCKET_BROWSE_URL=
BITBUCKET_TOKEN=

# ---- Trello ----------------------------------------------------------------
# The key comes from a Power-Up you create at https://trello.com/apps/admin ->
# API Key tab; since 2024 there is no other way to get one. The key is public,
# the token is not. Board ids go in the app config, not here.
TRELLO_ENABLED=false
TRELLO_KEY=
TRELLO_TOKEN=
# Periodic sweep for cards dragged or deleted by hand. Off by default.
TRELLO_RECONCILIATION_ENABLED=false

# ---- Jira ------------------------------------------------------------------
# Optional and cosmetic: supplies the issue summary for card titles. Without it,
# cards are titled from the pull request. Personal access token, sent as Bearer.
JIRA_ENABLED=false
JIRA_BASE_URL=http://host.docker.internal:8080
JIRA_TOKEN=
