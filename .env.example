# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# ---- database (used by docker-compose for both services) -------------------
POSTGRES_DB=inframanager
POSTGRES_USER=inframanager
POSTGRES_PASSWORD=

# Host-side port mappings. Change if something already listens there.
DB_HOST_PORT=5433
APP_HOST_PORT=8080

# ---- app -------------------------------------------------------------------
LOG_LEVEL=INFO

# ---- integrations ----------------------------------------------------------
# Not read yet -- wired up in later phases. Listed here so the full set of
# required secrets is visible in one place from the start.

# Telegram (phase 2): token from @BotFather.
# TELEGRAM_BOT_TOKEN=

# Bamboo (phase 3): base URL as seen from inside the container, plus the shared
# secret embedded in the Bamboo webhook template.
# BAMBOO_BASE_URL=http://host.docker.internal:8085
# BAMBOO_TOKEN=
# BAMBOO_WEBHOOK_SECRET=

# Bitbucket (phase 4): HTTP access token, and the webhook secret used for the
# X-Hub-Signature HMAC.
# BITBUCKET_BASE_URL=http://host.docker.internal:7990
# BITBUCKET_TOKEN=
# BITBUCKET_WEBHOOK_SECRET=

# Trello (phase 4): key comes from a Power-Up you create at
# https://trello.com/apps/admin -> API Key tab. The key is public, the token is not.
# TRELLO_KEY=
# TRELLO_TOKEN=

# Jira (phase 5): personal access token, sent as a Bearer header.
# JIRA_BASE_URL=http://host.docker.internal:8080
# JIRA_TOKEN=
